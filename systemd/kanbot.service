[Unit]
Description=Kanbot, a local kanban board
# Keep retrying, so a slow disk mount or a busy port doesn't stop the board for good.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=@REPO@
# Optional settings, such as KANBOT_DATABASE_URL. See docs/supabase.md.
EnvironmentFile=-%h/.config/kanbot.env
ExecStart="@UV@" run --quiet kanbot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
