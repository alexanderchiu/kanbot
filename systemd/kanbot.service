[Unit]
Description=Kanbot, a local kanban board
# Keep retrying, so a slow disk mount or a busy port doesn't stop the board for good.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=@REPO@
ExecStart="@UV@" run --quiet server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
