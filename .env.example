# Copy to .env and edit. .env is not tracked by git or replaced by deploy-synology.sh.

# Names or IPs you'll type in the browser to reach the board, comma-separated.
# localhost is always allowed. * allows any name but removes DNS rebinding protection.
KANBOT_ALLOWED_HOSTS=nas.local,192.168.1.10

# Port on the NAS.
KANBOT_PUBLISH_PORT=8787
